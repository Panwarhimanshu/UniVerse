{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "universeportal.vercel.app" }],
      "destination": "https://www.universepartner.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://universeportal-api.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/app" }
  ],
  "headers": [
    {
      "source": "/(dashboard|admin|partner-login|agent-login|reset-password|sign-agreement)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
