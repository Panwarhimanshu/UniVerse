PORT=4000
# MongoDB Atlas connection string. Leave empty to use a throwaway in-memory database.
MONGODB_URI=
MONGODB_DB=universe
JWT_SECRET=change-me-to-a-long-random-string

# Master admin, created on first start when none exists
MASTER_NAME=Master Admin
MASTER_EMAIL=admin@example.com
MASTER_PASSWORD=

# Optional first staff login
ADMIN_NAME=UniVerse Desk
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public website address, used in email links
SITE_URL=https://universeportal.vercel.app

# Outgoing email (applications, agreements, password links, notifications). Emails are skipped until set.
# Option 1, Microsoft 365 (recommended): an Entra app with the Microsoft Graph "Mail.Send" application
# permission (admin consent granted). MAIL_FROM must be a real mailbox in the tenant.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Option 2, any SMTP server. Microsoft 365: smtp.office365.com, port 587, SMTP AUTH enabled on the mailbox
# (Microsoft disables password SMTP by default from end of December 2026, so prefer option 1).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UniVerse <noreply@example.com>

# Push notifications: path to the Firebase service account key (local), or the whole JSON in
# FIREBASE_SERVICE_ACCOUNT (Vercel). Push is skipped until one is set.
FIREBASE_SERVICE_ACCOUNT_FILE=../secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary for profile photos (Dashboard → API Keys). Without it, photos are stored in MongoDB.
CLOUDINARY_URL=

# RazorpayX Payouts (withdrawals by UPI / IMPS / NEFT). Without these, the desk pays by hand and enters the UTR.
# Webhook URL: https://universeportal.vercel.app/api/webhooks/razorpay (events payout.processed, payout.failed,
# payout.reversed, payout.rejected)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
