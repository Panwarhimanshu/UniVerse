PORT=4000
# MongoDB Atlas connection string. Leave empty to use a throwaway in-memory database.
MONGODB_URI=
MONGODB_DB=universe
JWT_SECRET=change-me-to-a-long-random-string

# Master admin, created on first start when none exists
MASTER_NAME=Master Admin
MASTER_EMAIL=admin@example.com
MASTER_PASSWORD=

# Optional first staff login
ADMIN_NAME=UniVerse Desk
ADMIN_EMAIL=
ADMIN_PASSWORD=
